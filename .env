# Auth0 Configuration - Development Mode
# Note: Replace with actual Auth0 tenant when available
VITE_AUTH0_DOMAIN=dev-nextgen-fusion.us.auth0.com
VITE_AUTH0_CLIENT_ID=your-auth0-client-id
VITE_AUTH0_AUDIENCE=https://nextgen-fusion-api.com
VITE_AUTH0_REDIRECT_URI=http://localhost:5173/callback
VITE_AUTH0_LOGOUT_URI=http://localhost:5173

# API Configuration
API_BASE_URL=http://localhost:8000

# Auth0 API Configuration (Backend)
AUTH0_DOMAIN=dev-nextgen-fusion.us.auth0.com
AUTH0_API_AUDIENCE=https://nextgen-fusion-api.com
AUTH0_ISSUER=https://dev-nextgen-fusion.us.auth0.com/

# Development Environment
NODE_ENV=development
VITE_ENV=development

# Security
VITE_ENABLE_MFA=false
VITE_ENABLE_SSO=false