# Environment Configuration
ENVIRONMENT=development
DEBUG=true
SERVICE_NAME=design-service
SERVICE_VERSION=1.0.0

# Server Configuration
HOST=0.0.0.0
PORT=8000
WORKERS=4
TRUSTED_HOSTS=localhost,127.0.0.1,*.nextgenfusion.com

# API Configuration
API_PREFIX=/api/v1
API_TITLE="NextGen Fusion Design Service"
API_DESCRIPTION="Comprehensive solar design service"
API_VERSION=1.0.0

# Database Configuration
DATABASE_URL=postgresql+asyncpg://design_user:design_pass@localhost:5432/design_db
DATABASE_SYNC_URL=postgresql://design_user:design_pass@localhost:5432/design_db
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=30
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=3600
DATABASE_AUTO_CREATE_TABLES=true
DATABASE_ECHO=false

# Redis Configuration
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=
REDIS_DB=0
REDIS_MAX_CONNECTIONS=20
REDIS_RETRY_ON_TIMEOUT=true
REDIS_SOCKET_TIMEOUT=5
REDIS_SOCKET_CONNECT_TIMEOUT=5

# Authentication Configuration
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ISSUER=nextgen-fusion
JWT_AUDIENCE=design-service

# CORS Configuration
CORS_ENABLED=true
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://app.nextgenfusion.com
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS,PATCH
CORS_ALLOWED_HEADERS=*
CORS_EXPOSE_HEADERS=X-Request-ID,X-Rate-Limit-Remaining
CORS_MAX_AGE=86400

# Rate Limiting Configuration
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=100
RATE_LIMIT_BURST_SIZE=20
RATE_LIMIT_STORAGE_URL=redis://localhost:6379/1

# File Storage Configuration
FILE_STORAGE_TYPE=local
FILE_STORAGE_BASE_PATH=./storage
FILE_STORAGE_MAX_FILE_SIZE=104857600
FILE_STORAGE_ALLOWED_EXTENSIONS=.pdf,.dwg,.dxf,.png,.jpg,.jpeg,.svg,.xlsx,.csv

# AWS S3 Configuration (if using S3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=nextgen-fusion-design-files
AWS_S3_PREFIX=design-service/

# Weather Data Configuration
WEATHER_API_KEY=your-weather-api-key
WEATHER_API_URL=https://api.openweathermap.org/data/2.5
WEATHER_CACHE_TTL=3600
WEATHER_REQUEST_TIMEOUT=30
WEATHER_MAX_RETRIES=3

# Performance Calculation Configuration
PERFORMACE_SIMULATION_YEARS=25
PERFORMANCE_DEGRADATION_RATE=0.005
PERFORMANCE_SYSTEM_LOSSES=0.14
PERFORMANCE_INVERTER_EFFICIENCY=0.96
PERFORMANCE_DC_AC_RATIO=1.2
PERFORMANCE_CACHE_TTL=1800

# Optimization Configuration
OPTIMIZATION_MAX_ITERATIONS=1000
OPTIMIZATION_CONVERGENCE_TOLERANCE=0.001
OPTIMIZATION_POPULATION_SIZE=50
OPTIMIZATION_MUTATION_RATE=0.1
OPTIMIZATION_CROSSOVER_RATE=0.8
OPTIMIZATION_TIMEOUT_SECONDS=300

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE_PATH=./logs/design-service.log
LOG_FILE_MAX_SIZE=10485760
LOG_FILE_BACKUP_COUNT=5
LOG_CORRELATION_ID_HEADER=X-Correlation-ID

# Monitoring Configuration
MONITORING_ENABLED=true
METRICS_ENABLED=true
METRICS_PORT=9090
METRICS_PATH=/metrics
TRACING_ENABLED=true
TRACING_ENDPOINT=http://localhost:14268/api/traces
TRACING_SERVICE_NAME=design-service
TRACING_SAMPLE_RATE=0.1

# Health Check Configuration
HEALTH_CHECK_TIMEOUT=30
HEALTH_CHECK_INTERVAL=60

# External Services
GATEWAY_URL=http://localhost:3001
COMPLIANCE_SERVICE_URL=http://localhost:8001
FINANCE_SERVICE_URL=http://localhost:8002
PROCURE_SERVICE_URL=http://localhost:8003
OPS_SERVICE_URL=http://localhost:8004
SUPPORT_SERVICE_URL=http://localhost:8005

# Celery Configuration (for background tasks)
CELERY_BROKER_URL=redis://localhost:6379/2
CELERY_RESULT_BACKEND=redis://localhost:6379/3
CELERY_TASK_SERIALIZER=json
CELERY_RESULT_SERIALIZER=json
CELERY_ACCEPT_CONTENT=json
CELERY_TIMEZONE=UTC
CELERY_ENABLE_UTC=true

# Security Configuration
SECURE_HEADERS_ENABLED=true
HSTS_MAX_AGE=31536000
HSTS_INCLUDE_SUBDOMAINS=true
CSP_ENABLED=false
CSP_POLICY="default-src 'self'"

# Development Configuration
DEV_RELOAD=true
DEV_DEBUG_TOOLBAR=true
DEV_PROFILER=false

# Testing Configuration
TEST_DATABASE_URL=postgresql+asyncpg://test_user:test_pass@localhost:5432/test_design_db
TEST_REDIS_URL=redis://localhost:6379/15