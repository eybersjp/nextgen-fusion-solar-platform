# NextGen Fusion Design Service Environment Configuration

# Application settings
APP_NAME=NextGen Fusion Design Service
APP_VERSION=1.0.0
DEBUG=true
ENVIRONMENT=development

# Server settings
HOST=0.0.0.0
PORT=8001
RELOAD=true

# Security settings
SECRET_KEY=dev-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Database settings (using SQLite for development)
DATABASE_URL=sqlite:///./nextgen_design.db
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=3600

# Redis settings (optional for development)
REDIS_URL=redis://localhost:6379/0
REDIS_POOL_SIZE=10
REDIS_TIMEOUT=5

# Logging settings
LOG_LEVEL=INFO
LOG_FORMAT=json

# CORS settings
CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173"]
CORS_CREDENTIALS=true
CORS_METHODS=["GET", "POST", "PUT", "DELETE", "OPTIONS"]
CORS_HEADERS=["*"]

# File storage settings
STORAGE_TYPE=local
STORAGE_PATH=./storage
MAX_FILE_SIZE=104857600

# External service URLs
API_GATEWAY_URL=http://localhost:8000
COMPLIANCE_SERVICE_URL=http://localhost:8002
FINANCE_SERVICE_URL=http://localhost:8003
PROCURE_SERVICE_URL=http://localhost:8004
OPS_SERVICE_URL=http://localhost:8005
SUPPORT_SERVICE_URL=http://localhost:8006

# Solar calculation settings
PVLIB_CACHE_SIZE=1000
SOLAR_POSITION_CACHE_TTL=3600

# BOM settings
DEFAULT_CURRENCY=USD
CURRENCY_UPDATE_INTERVAL=3600
PRICE_CACHE_TTL=1800

# Monitoring and observability
ENABLE_METRICS=true
METRICS_PORT=9090
ENABLE_TRACING=false

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# Background tasks
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Compliance settings
DEFAULT_COUNTRY_CODE=US
COMPLIANCE_CACHE_TTL=3600

# AI/ML settings
AI_MODEL_CACHE_SIZE=100
AI_PREDICTION_TIMEOUT=30